<?xml version="1.0" encoding="utf-8"?>
<!--
   Eat Better stores all user data in a local Room/SQLite database.
   Auto Backup is intentionally disabled to honor the "100% Offline & Private"
   promise made in the app's UI and Privacy Policy.
   See: https://developer.android.com/guide/topics/data/autobackup
-->
<full-backup-content>
    <exclude domain="database" path="."/>
    <exclude domain="sharedpref" path="."/>
</full-backup-content>